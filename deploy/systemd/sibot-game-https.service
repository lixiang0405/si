[Unit]
Description=Si Game Room public HTTPS
Wants=network-online.target
After=network-online.target sibot-game.service
Requires=sibot-game.service
ConditionPathExists=/etc/si-game-https/public-host.env

[Service]
User=sibot
Group=sibot
StateDirectory=si-game-https
StateDirectoryMode=0700
Environment=XDG_DATA_HOME=/var/lib/si-game-https
Environment=XDG_CONFIG_HOME=/var/lib/si-game-https
EnvironmentFile=/etc/si-game-https/public-host.env
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UMask=0077
ExecStart=/srv/sibot/bin/caddy-game-https run --config /etc/si-game-https/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target

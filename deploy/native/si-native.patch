-fn gif_sub_blocks_end(bytes: &[u8], mut position: usize) -> Option<usize> {
-    loop {
-        let length = *bytes.get(position)? as usize;
-        position = position.checked_add(1 + length)?;
-        if position > bytes.len() {
-            return None;
-        }
-        if length == 0 {
-            return Some(position);
-        }
-    }
-}
